{
	"compatibility_date": "2026-04-30",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "asir",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		// Cloudflare answers a matching asset before the Worker, so the
		// canonical-host, trailing-slash and 410 rules in src/worker.ts would
		// never see prerendered pages. Send every page path through the Worker
		// and leave the content-hashed build output and Outside photo
		// derivatives on the pure asset path.
		"run_worker_first": [
			"/*",
			"!/_astro/*",
			"!/outside/assets/*",
			"!/outside/zion/*",
			"!/outside/hoover-dam/*"
		]
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"routes": [
		{
			"pattern": "asir.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.asir.dev",
			"custom_domain": true
		}
	]
}