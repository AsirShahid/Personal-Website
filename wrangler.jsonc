{
	"compatibility_date": "2026-04-30",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "asir",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		// Run the Worker before serving static assets so the middleware
		// (www redirect, security headers) applies to prerendered pages too.
		"run_worker_first": true
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"routes": [
		{
			"pattern": "asir.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.asir.dev",
			"custom_domain": true
		}
	]
}