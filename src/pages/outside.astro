---
export const prerender = true;
import "../styles/global.css";
import data from "@/data/outside-studies.json";

type Img = { src: string; w: number; h: number; d: string; t: string; se: number; ex: string; fl: string; cam: string; avg: string; tz?: string };
type Series = { start: number; count: number; time: string; title?: string; date?: string; dateEnd?: string; key?: number };
type Study = { id: string; place: string; region: string; country: string; status: string; date: string; dateEnd: string; tz: string; key: number; journey?: { id: string; title: string }; series: Series[]; images: Img[] };
type Alias = { studyId: string; indices: (number | null)[]; defaultIndex?: number };
type SourceData = { studies?: Study[]; aliases?: Record<string, Alias> };

const sourceData = data as SourceData;
const fallbackImg: Img = { src: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 240'%3E%3Crect width='320' height='240' fill='%23050505'/%3E%3Ctext x='50%25' y='50%25' fill='%238d8b86' font-size='12' text-anchor='middle'%3ENO IMAGE DATA%3C/text%3E%3C/svg%3E", w: 320, h: 240, d: "", t: "", se: 1, ex: "", fl: "", cam: "", avg: "#050505" };
const fallbackStudy: Study = { id: "no-studies", place: "No studies available", region: "", country: "", status: "PENDING", date: "", dateEnd: "", tz: "", key: 0, series: [{ start: 0, count: 1, time: "" }], images: [fallbackImg] };
const validStudies = (sourceData.studies ?? []).filter((s) => Array.isArray(s.images) && s.images.length > 0);
const studies = (validStudies.length ? validStudies : [fallbackStudy]).slice().sort((a, b) => (b.dateEnd || b.date || "").localeCompare(a.dateEnd || a.date || ""));
const aliases = sourceData.aliases ?? {};
const totalImages = studies.reduce((n, s) => n + s.images.length, 0);
const first = studies[0];
const firstImg = first.images[0] ?? fallbackImg;
const studyCover = (s: Study) => s.images[s.key] ?? s.images[0] ?? fallbackImg;
const pad = (n: number) => String(n).padStart(2, "0");
const title = "Outside Studies | Asir Shahid";
const dateLabel = (s: Study) => (s.dateEnd !== s.date ? `${s.date} to ${s.dateEnd.slice(5)}` : s.date);
const where = (s: Study) => [s.region, s.country].filter(Boolean).join(" · ");
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content="Photographs from elsewhere, hung like imaging studies." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preload" as="image" href={firstImg.src.startsWith("data:") ? firstImg.src : `${firstImg.src}-l.webp`} media="(min-width: 900px)" />
    <script is:inline>
      if (location.hash) document.documentElement.classList.add("oz-route-fragment-pending");
    </script>
    <style is:global>
      html.oz-route-fragment-pending .oz-reader,
      html.oz-route-unavailable .oz-reader { visibility: hidden !important; }
    </style>
  </head>
  <body class="oz">
    <div class="oz-shell">
      <header class="oz-top">
        <div class="oz-brand">
          <a href="/" class="oz-home">asir.dev</a>
          <span class="oz-slash" aria-hidden="true">/</span>
          <h1>Outside Studies</h1>
        </div>
        <p class="oz-topmeta"><span>XC</span><span>{studies.length} studies</span><span>{totalImages} images</span></p>
        <button class="oz-helpbtn" type="button" data-help-open aria-label="Viewer shortcuts">?</button>
      </header>

      <aside class="oz-worklist" aria-label="Worklist">

        <div class="oz-wlhead" aria-hidden="true"><span>Study</span><span>Status</span></div>
        <ol class="oz-rows">
          {studies.map((s, idx) => {
            const k = studyCover(s);
            return (
              <li>

                <a class="oz-row" href={`#${s.id}`} data-study={idx} aria-label={`${s.place}, ${dateLabel(s)}, ${s.images.length} images`}>
                  <span class="oz-thumb" style={`--avg:${k.avg}`}>
                    <img
                      src={`${k.src}-s.webp`}
                      srcset={`${k.src}-s.webp 360w, ${k.src}-m.webp 1080w`}
                      sizes="(max-width: 899px) 100vw, 84px"
                      width={k.w}
                      height={k.h}
                      alt=""
                      loading={idx < 3 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </span>
                  <span class="oz-rowtext">
                    <span class="oz-place">{s.place}</span>
                    <span class="oz-sub">{dateLabel(s)} · {s.images.length} im</span>
                    <span class="oz-sub oz-region">{where(s) || "Location pending"}</span>
                  </span>
                  <span class="oz-status" data-status={s.status}>{s.status}</span>
                  <span class="oz-card-ov oz-card-tl" aria-hidden="true"><b>{s.place}</b><br />{where(s) || "Location pending"}</span>
                  <span class="oz-card-ov oz-card-tr" aria-hidden="true">XC · {pad(idx + 1)}/{pad(studies.length)}<br />{s.images.length} IM · {s.series.length} SE</span>
                  <span class="oz-card-ov oz-card-bl" aria-hidden="true">{dateLabel(s)}</span>
                  <span class="oz-card-ov oz-card-br" aria-hidden="true"><span data-status={s.status}>{s.status}</span></span>
                </a>
              </li>
            );
          })}
        </ol>

      </aside>

      <section class="oz-reader" data-reader aria-label="Study viewer">
        <div class="oz-tools" role="toolbar" aria-label="Viewer tools">
          <button type="button" class="oz-close" data-close aria-label="Back to worklist"><span aria-hidden="true">←</span><span class="oz-close-label">Worklist</span></button>
          <span class="oz-tooltitle" data-tooltitle>{first.place}</span>
          <div class="oz-toolset">
            <button type="button" data-tool="stack" aria-pressed="true"><kbd>S</kbd>Stack</button>
            <button type="button" data-tool="wl" aria-pressed="false"><kbd>W</kbd>W/L</button>
            <button type="button" data-cine aria-pressed="false"><kbd>C</kbd>Cine</button>
            <button type="button" data-layout aria-pressed="false" class="oz-desktop-only"><kbd>L</kbd>2×2</button>
            <button type="button" data-invert aria-pressed="false" class="oz-desktop-only"><kbd>I</kbd>Invert</button>
            <button type="button" data-info aria-pressed="true"><kbd>O</kbd>Info</button>
            <button type="button" data-reset class="oz-desktop-only"><kbd>R</kbd>Reset</button>
          </div>
        </div>

        <div
          class="oz-viewport"
          data-viewport
          tabindex="0"
          role="application"
          aria-roledescription="image stack viewer"
          aria-label="Image stack. Arrow keys page through images. Page up and page down change series. N and P change study."
        >
          <div class="oz-cells" data-cells data-layout="1">
            <div class="oz-cell" style={`--avg:${firstImg.avg}`}>
              <img src={firstImg.src.startsWith("data:") ? firstImg.src : `${firstImg.src}-m.webp`} width={firstImg.w} height={firstImg.h} alt={`Photograph 1 of ${first.images.length}, ${first.place}`} draggable="false" decoding="async" loading="lazy" />
              <span class="oz-cell-label"></span>
            </div>
          </div>
          <div class="oz-ov oz-ov-tl" data-ov="tl"></div>
          <div class="oz-ov oz-ov-tr" data-ov="tr"></div>
          <div class="oz-ov oz-ov-bl" data-ov="bl"></div>
          <div class="oz-ov oz-ov-br" data-ov="br"></div>
          <div class="oz-stackbar" data-stackbar aria-hidden="true">
            <div class="oz-stacktrack" data-stacktrack></div>
            <div class="oz-stackthumb" data-stackthumb></div>
          </div>
          <p class="oz-hint" data-hint><span class="oz-hint-desk">Scroll or drag to page through · <kbd>?</kbd> for keys</span><span class="oz-hint-touch">Drag to scrub · tap the edges to step</span></p>
        </div>

        <nav class="oz-series" data-series aria-label="Series in this study"></nav>
      </section>
    </div>

    <dialog class="oz-help" data-help>
      <div class="oz-help-head">
        <h2>Reading room shortcuts</h2>
        <button type="button" data-help-close aria-label="Close shortcuts">×</button>
      </div>
      <dl>
        <dt><kbd>↑</kbd><kbd>↓</kbd> <kbd>←</kbd><kbd>→</kbd> or wheel</dt><dd>Previous / next image</dd>
        <dt>Drag on image</dt><dd>Scrub through the stack</dd>
        <dt><kbd>PgUp</kbd><kbd>PgDn</kbd></dt><dd>Previous / next series</dd>
        <dt><kbd>Home</kbd><kbd>End</kbd></dt><dd>First / last image</dd>
        <dt><kbd>P</kbd><kbd>N</kbd></dt><dd>Previous / next study</dd>
        <dt><kbd>C</kbd> or <kbd>Space</kbd></dt><dd>Cine loop; <kbd>[</kbd> <kbd>]</kbd> change speed</dd>
        <dt><kbd>W</kbd></dt><dd>Window / level: drag sideways for contrast, up and down for brightness</dd>
        <dt><kbd>S</kbd></dt><dd>Back to stack scrolling</dd>
        <dt><kbd>L</kbd></dt><dd>Toggle 1×1 / 2×2 layout</dd>
        <dt><kbd>I</kbd></dt><dd>Invert</dd>
        <dt><kbd>O</kbd></dt><dd>Hide or show overlays</dd>
        <dt><kbd>R</kbd> or double-click</dt><dd>Reset window / level</dd>
      </dl>
    </dialog>
    <div class="oz-sr" aria-live="polite" data-live></div>
    <div class="oz-route-error" data-route-error role="alert" aria-live="assertive" hidden>This Outside Studies link is no longer available.</div>

    <script type="application/json" id="oz-data" set:html={JSON.stringify({ studies, aliases })}></script>

    <script>
      type Img = { src: string; w: number; h: number; d: string; t: string; se: number; ex: string; fl: string; cam: string; avg: string; tz?: string };
      type Series = { start: number; count: number; time: string; title?: string; date?: string; dateEnd?: string; key?: number };
      type Study = { id: string; place: string; region: string; country: string; status: string; date: string; dateEnd: string; tz: string; key: number; journey?: { id: string; title: string }; series: Series[]; images: Img[] };
      type Alias = { studyId: string; indices: (number | null)[]; defaultIndex?: number };

      const pageData = JSON.parse(document.getElementById("oz-data")!.textContent || "{}");
      const studies: Study[] = pageData.studies;
      const aliases: Record<string, Alias> = pageData.aliases ?? {};
      const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
      const desktopMQ = window.matchMedia("(min-width: 900px)");
      const reduceMQ = window.matchMedia("(prefers-reduced-motion: reduce)");
      const pad = (n: number) => String(n).padStart(2, "0");
      const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

      const body = document.body;
      const viewport = $("[data-viewport]");
      const cells = $("[data-cells]");
      const seriesNav = $("[data-series]");
      const stackTrack = $("[data-stacktrack]");
      const stackThumb = $("[data-stackthumb]");
      const stackBar = $("[data-stackbar]");
      const hint = $("[data-hint]");
      const live = $("[data-live]");
      const routeError = $("[data-route-error]");
      const toolTitle = $("[data-tooltitle]");
      const helpDialog = $<HTMLDialogElement>("[data-help]");
      const ov = {
        tl: $("[data-ov=tl]"),
        tr: $("[data-ov=tr]"),
        bl: $("[data-ov=bl]"),
        br: $("[data-ov=br]"),
      };
      const rows = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-study]"));

      const state = {
        s: 0,
        i: 0,
        tool: "stack" as "stack" | "wl",
        layout: 1 as 1 | 4,
        cine: 0 as number,
        fps: 0.5,
        invert: false,
        info: true,
        W: 255,
        L: 128,
        open: false,
        interacted: false,
      };

      const study = () => studies[state.s];
      const seriesList = () => study().series.slice().sort((a, b) => a.start - b.start);
      const seriesIndex = (i: number) => {
        const list = seriesList();
        let k = 0;
        for (let j = 0; j < list.length; j++) if (list[j].start <= i) k = j;
        return k;
      };

      // ---------- image cache: show a light proxy instantly, swap to full when decoded ----------
      const cache = new Map<string, Promise<void>>();
      const ready = new Set<string>();
      const load = (url: string) => {
        let p = cache.get(url);
        if (!p) {
          p = new Promise<void>((resolve, reject) => {
            const im = new Image();
            im.decoding = "async";
            im.onload = () => { ready.add(url); resolve(); };
            im.onerror = () => { cache.delete(url); reject(new Error(url)); };
            im.src = url;
          });
          cache.set(url, p);
        }
        return p;
      };
      const fullUrl = (img: Img) => {
        if (img.src.startsWith("data:")) return img.src;
        const px = (viewport.clientWidth / (state.layout === 4 ? 2 : 1)) * (window.devicePixelRatio || 1);
        return `${img.src}${px > 1400 ? "-l" : "-m"}.webp`;
      };
      const thumbUrl = (img: Img) => img.src.startsWith("data:") ? img.src : `${img.src}-s.webp`;

      // ---------- rendering ----------
      const makeCell = () => {
        const cell = document.createElement("div");
        cell.className = "oz-cell";
        const im = document.createElement("img");
        im.draggable = false;
        im.decoding = "async";
        const label = document.createElement("span");
        label.className = "oz-cell-label";
        cell.append(im, label);
        return cell;
      };
      const ensureCells = () => {
        const n = state.layout;
        while (cells.children.length < n) cells.append(makeCell());
        while (cells.children.length > n) cells.lastElementChild!.remove();
        cells.dataset.layout = String(n);
      };
      const paintCell = (cell: HTMLElement, idx: number) => {
        const st = study();
        const img = st.images[idx];
        const el = cell.querySelector("img")!;
        const label = cell.querySelector<HTMLElement>(".oz-cell-label")!;
        if (!img) {
          cell.classList.add("is-empty");
          el.removeAttribute("src");
          el.alt = "";
          label.textContent = "";
          return;
        }
        cell.classList.remove("is-empty");
        cell.style.setProperty("--avg", img.avg);
        const full = fullUrl(img);
        el.dataset.want = full;
        el.width = img.w;
        el.height = img.h;
        el.alt = `Photograph ${idx + 1} of ${st.images.length}, ${st.place}`;
        if (ready.has(full)) {
          if (el.getAttribute("src") !== full) el.src = full;
          el.classList.remove("is-proxy");
        } else {
          el.src = thumbUrl(img);
          el.classList.add("is-proxy");
          load(full).then(() => {
            if (el.dataset.want === full) {
              el.src = full;
              el.classList.remove("is-proxy");
            }
          }).catch(() => {});
        }
        label.textContent = state.layout === 4 ? `IM ${idx + 1}` : "";
      };

      const line = (box: HTMLElement, items: Array<string | [string, string]>) => {
        box.replaceChildren(
          ...items.filter(Boolean).map((item) => {
            const div = document.createElement("div");
            if (Array.isArray(item)) {
              div.className = item[1];
              div.textContent = item[0];
            } else div.textContent = item;
            return div;
          }),
        );
      };
      const renderOverlay = () => {
        const st = study();
        const img = st.images[state.i];
        const se = seriesIndex(state.i);
        const where = [st.region, st.country].filter(Boolean).join(" · ") || "Location pending";
        const date = st.dateEnd !== st.date ? `${st.date} to ${st.dateEnd.slice(5)}` : st.date;
        line(ov.tl, [[st.place.toUpperCase(), "oz-ov-strong"], where.toUpperCase(), `STUDY ${date}`, `XC · ${pad(state.s + 1)}/${pad(studies.length)}`]);
        line(ov.tr, [
          "ASIR SHAHID",
          `SE ${se + 1}/${st.series.length}   IM ${state.i + 1}/${st.images.length}`,
          `${img.d}  ${img.t}`,
          img.tz || st.tz,
          state.i === st.key ? ["KEY IMAGE", "oz-ov-key"] : "",
        ]);
        line(ov.bl, [img.ex, img.fl, img.cam.toUpperCase()]);
        line(ov.br, [
          state.cine ? [`CINE ${state.fps} FPS`, "oz-ov-key"] : "",
          state.invert ? "INVERTED" : "",
          `W ${state.W}  L ${state.L}`,
          [st.status, `oz-ov-status oz-st-${st.status.toLowerCase()}`],
        ]);
      };

      const renderStackTicks = () => {
        const st = study();
        const n = st.images.length;
        const pos = (k: number) => (n > 1 ? (k / (n - 1)) * 100 : 0);
        stackTrack.replaceChildren(
          ...seriesList().map((s, k) => {
            const t = document.createElement("span");
            t.className = k === 0 ? "oz-tick oz-tick-first" : "oz-tick";
            t.style.top = `${pos(s.start)}%`;
            return t;
          }),
          (() => {
            const key = document.createElement("span");
            key.className = "oz-tick oz-tick-key";
            key.style.top = `${pos(st.key)}%`;
            return key;
          })(),
        );
      };
      const renderStack = () => {
        const n = study().images.length;
        stackThumb.style.top = `${n > 1 ? (state.i / (n - 1)) * 100 : 0}%`;
        stackThumb.dataset.label = String(state.i + 1);
      };

      const renderSeriesNav = () => {
        const st = study();
        seriesNav.replaceChildren(
          ...seriesList().map((s, k) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "oz-se";
            b.dataset.se = String(k);
            const cover = Number.isInteger(s.key) && st.images[s.key!] ? s.key! : clamp(s.start, 0, st.images.length - 1);
            const chapterDate = s.date ? (s.dateEnd && s.dateEnd !== s.date ? `${s.date} to ${s.dateEnd.slice(5)}` : s.date) : s.time;
            const chapterName = s.title || `Series ${k + 1}`;
            b.dataset.start = String(s.start);
            b.dataset.key = String(cover);
            b.setAttribute("aria-label", `Series ${k + 1}, ${chapterName}, ${chapterDate}, ${s.count} images, cover image ${cover + 1}`);
            const im = document.createElement("img");
            im.src = thumbUrl(st.images[cover] ?? st.images[s.start] ?? st.images[0]);
            im.alt = "";
            im.loading = "lazy";
            im.decoding = "async";
            const cap = document.createElement("span");
            cap.className = "oz-se-cap";
            const name = document.createElement("b");
            name.textContent = `SE ${k + 1} · ${chapterName}`;
            const detail = document.createElement("span");
            detail.textContent = `${chapterDate} · ${s.count} im · KEY ${cover + 1}`;
            cap.append(name, detail);
            b.append(im, cap);
            b.addEventListener("click", () => { cancelPendingTap(); touch(); stopCine(); state.i = clamp(s.start, 0, st.images.length - 1); render(); });
            return b;
          }),
        );
      };
      const renderSeriesActive = () => {
        const active = seriesIndex(state.i);
        seriesNav.querySelectorAll<HTMLElement>(".oz-se").forEach((b, k) => {
          const on = k === active;
          b.classList.toggle("is-active", on);
          if (on) b.setAttribute("aria-current", "true");
          else b.removeAttribute("aria-current");
        });
        const activeEl = seriesNav.querySelector<HTMLElement>(".oz-se.is-active");
        if (activeEl) {
          const r = activeEl.getBoundingClientRect();
          const nr = seriesNav.getBoundingClientRect();
          if (r.left < nr.left || r.right > nr.right) {
            seriesNav.scrollTo({ left: activeEl.offsetLeft - nr.width / 2 + r.width / 2, behavior: reduceMQ.matches ? "auto" : "smooth" });
          }
        }
      };

      const applyFilters = () => {
        const c = 255 / state.W;
        const b = 1 + (128 - state.L) / 160;
        const parts = [];
        if (state.invert) parts.push("invert(1)");
        if (state.W !== 255) parts.push(`contrast(${c.toFixed(3)})`);
        if (state.L !== 128) parts.push(`brightness(${b.toFixed(3)})`);
        cells.style.filter = parts.join(" ");
      };

      const preloadAround = () => {
        const imgs = study().images;
        for (const k of [1, 2, -1, 3, -2, 4, 5]) {
          const img = imgs[state.i + k];
          if (img) load(fullUrl(img)).catch(() => {});
        }
      };

      let hashTimer = 0;
      const updateHash = () => {
        window.clearTimeout(hashTimer);
        hashTimer = window.setTimeout(() => {
          const h = `#${study().id}/${state.i + 1}`;
          if (location.hash !== h && (desktopMQ.matches || state.open)) history.replaceState(history.state, "", h);
        }, 220);
      };

      let liveTimer = 0;
      const announce = () => {
        window.clearTimeout(liveTimer);
        liveTimer = window.setTimeout(() => {
          live.textContent = `${study().place}. Series ${seriesIndex(state.i) + 1}. Image ${state.i + 1} of ${study().images.length}.`;
        }, 400);
      };

      const render = () => {
        ensureCells();
        Array.from(cells.children).forEach((c, k) => paintCell(c as HTMLElement, state.i + k));
        renderOverlay();
        renderStack();
        renderSeriesActive();
        applyFilters();
        preloadAround();
        updateHash();
        announce();
      };

      // ---------- navigation ----------
      const go = (delta: number, wrap = false) => {
        const n = study().images.length;
        let i = state.i + delta;
        i = wrap ? ((i % n) + n) % n : clamp(i, 0, n - 1);
        if (i !== state.i) {
          state.i = i;
          render();
        }
      };
      const goSeries = (delta: number) => {
        const list = seriesList();
        const k = clamp(seriesIndex(state.i) + delta, 0, list.length - 1);
        state.i = list[k].start;
        render();
      };

      const openStudy = (s: number, i?: number, opts: { push?: boolean } = {}) => {
        clearRouteError();
        stopCine();
        cancelPendingTap();
        const changed = s !== state.s;
        state.s = clamp(s, 0, studies.length - 1);
        const st = study();
        state.i = clamp(i ?? 0, 0, st.images.length - 1);
        if (changed) { state.W = 255; state.L = 128; state.invert = false; syncButtons(); }
        rows.forEach((r, k) => {
          if (k === state.s) r.setAttribute("aria-current", "true");
          else r.removeAttribute("aria-current");
        });
        toolTitle.textContent = st.place;
        renderSeriesNav();
        renderStackTicks();
        if (changed && !reduceMQ.matches) {
          cells.classList.remove("is-switching");
          void cells.offsetWidth;
          cells.classList.add("is-switching");
        }
        render();
        st.images.forEach((img, k) => window.setTimeout(() => load(thumbUrl(img)).catch(() => {}), 40 + k * 12));
        if (!desktopMQ.matches && !state.open) {
          state.open = true;
          body.classList.add("is-reading");
          if (opts.push !== false) history.pushState({ oz: 1 }, "", `#${st.id}/${state.i + 1}`);
          window.setTimeout(() => viewport.focus({ preventScroll: true }), 60);
        }
      };
      const closeReader = () => {
        if (!state.open) return;
        cancelPendingTap();
        stopCine();
        state.open = false;
